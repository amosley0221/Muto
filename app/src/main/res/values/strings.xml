    <string name="settings_block_mode">How blocked names are answered</string>
    <string name="block_mode_nxdomain">Say the name does not exist</string>
    <string name="block_mode_nxdomain_help">The default. Understood by every app, and the closest thing to the domain simply not being there.</string>
    <string name="block_mode_null_ip">Answer with an unusable address</string>
    <string name="block_mode_null_ip_help">Replies with 0.0.0.0. Some apps stop retrying sooner this way, but a few show a connection error instead of nothing.</string>
    <string name="block_mode_refused">Refuse the query</string>
    <string name="block_mode_refused_help">Makes it obvious in logs that a filter is in play. Useful for debugging, not for everyday use.</string>

    <string name="settings_apps">Apps that bypass Muto</string>
    <string name="settings_apps_none">None — every app is filtered</string>
    <string name="settings_apps_count">%1$d app(s) excluded</string>

    <string name="settings_resolver">Upstream resolver</string>
    <string name="settings_ipv6">Filter IPv6 queries</string>
    <string name="settings_ipv6_help">Leave on unless your network has trouble with IPv6. Turning it off lets AAAA lookups go unfiltered.</string>

    <string name="settings_update_interval">Update lists every</string>
    <string name="settings_update_interval_value">%1$d hours</string>
    <string name="settings_update_unmetered">Only on Wi-Fi</string>
    <string name="settings_update_unmetered_help">Block lists are several megabytes each.</string>

    <string name="settings_keep_history">Keep a history on this device</string>
    <string name="settings_keep_history_help">Off by default. The live log always works; this only controls whether it survives a restart.</string>
    <string name="settings_retention">Keep history for</string>
    <string name="settings_retention_value">%1$d hours</string>
    <string name="settings_clear_history">Clear history now</string>
    <string name="settings_clear_history_help">Removes everything recorded so far.</string>

    <string name="settings_start_on_boot">Turn on after restarting</string>
    <string name="settings_start_on_boot_help">Only works if you have already granted VPN permission.</string>

    <string name="settings_about">Muto filters DNS locally on this device. No query ever leaves your phone except to the resolver you chose, and Muto sends nothing anywhere else.</string>

    <!-- Apps -->
    <string name="apps_title">App bypass</string>
    <string name="apps_help">An app switched on here is excluded from the tunnel entirely: its traffic is neither filtered nor visible to Muto. Use it for apps that refuse to run while a VPN is active.</string>

