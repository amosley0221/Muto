<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Listing includes means everything not listed is already excluded, so this file says what
      IS backed up and nothing else. Two things are deliberately absent:

        muto-tunnels.db   holds WireGuard private keys, which have no business in cloud backup
        files/lists       the compiled block lists, a cache that is stale by restore time and is
                          the largest thing Muto stores
    -->
    <include domain="database" path="muto.db" />
    <include domain="sharedpref" path="." />
</full-backup-content>
